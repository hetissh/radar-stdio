{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8417", "--directory", "site"],
      "port": 8417
    },
    {
      "name": "site-any-port",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "exec python3 -m http.server \"$PORT\" --directory site"],
      "port": 8418,
      "autoPort": true
    }
  ]
}
