{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [],
    "skipLibCheck": true
  },
  "include": ["types/**/*.d.ts", "public/js/**/*.js", "functions/**/*.js"],
  "exclude": ["public/js/core/config.js"]
}
