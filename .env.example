# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# On Cloudflare Pages, set the same names under Settings → Variables and Secrets
# (mark the server-only ones as "Secret").

# Development store, e.g. radar-studio-dev.myshopify.com (the .myshopify.com domain, not a custom domain)
SHOPIFY_STORE_DOMAIN=
# Pinned API version (YYYY-MM, quarterly). Use the latest stable version Shopify lists.
SHOPIFY_API_VERSION=2026-10

# Headless sales channel → your storefront → Storefront API
# Public token: safe in the browser, written into site/scripts/config.js at build time.
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
# Private token: server only (sync script, Pages Functions). Secret.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Dev Dashboard app with Admin API scopes, installed on the dev store (import, sync, webhooks).
# Server only. The client secret also verifies webhook signatures. Secret.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
